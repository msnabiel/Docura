GEMINI_API_KEY_PAID=your_gemini_api_key
DOCURA_API_TOKEN=choose_a_long_random_token
# For separate users, use a JSON mapping of owner IDs to distinct API tokens instead.
# DOCURA_API_TOKENS_JSON={"alice":"token_one","bob":"token_two"}
DOCURA_DATA_DIR=./data
DOCURA_DOCUMENT_TTL_SECONDS=86400
DOCURA_INDEX_TTL_SECONDS=3600
DOCURA_MAX_CACHED_INDEXES=8
DOCURA_GEMINI_MODEL=gemini-3.7-flash
DOCURA_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
DOCURA_ALLOWED_URL_HOSTS=
DOCURA_ALLOWED_ORIGINS=
